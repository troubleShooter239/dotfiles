{
  "editor.rulers": [120],
  "workbench.iconTheme": "material-icon-theme",
  "editor.mouseWheelZoom": true,
  "editor.fontSize": 16,
  "terminal.integrated.fontSize": 12,
  "telemetry.telemetryLevel": "off",
  "update.showReleaseNotes": false,
  "C_Cpp.default.cppStandard": "c++26",
  "C_Cpp.default.cStandard": "c23",
  "workbench.startupEditor": "none",
  "python.analysis.autoFormatStrings": true,
  "python.analysis.autoImportCompletions": true,
  "explorer.confirmDelete": false,
  "security.workspace.trust.startupPrompt": "never",
  "git.confirmSync": false,
  "git.autofetch": true,
  "cSpell.language": "en, ru",
  "editor.formatOnPaste": true,
  "prettier.useTabs": true,
  "prettier.jsxSingleQuote": true,
  "prettier.singleQuote": true,
  "prettier.arrowParens": "avoid",
  "breadcrumbs.icons": false,
  "breadcrumbs.showKeys": false,
  "breadcrumbs.showFiles": false,
  "breadcrumbs.symbolPath": "off",
  "breadcrumbs.showArrays": false,
  "breadcrumbs.showBooleans": false,
  "breadcrumbs.showClasses": false,
  "breadcrumbs.showConstants": false,
  "breadcrumbs.showConstructors": false,
  "breadcrumbs.showEnumMembers": false,
  "breadcrumbs.showEvents": false,
  "breadcrumbs.showFields": false,
  "breadcrumbs.showEnums": false,
  "breadcrumbs.showFunctions": false,
  "breadcrumbs.showInterfaces": false,
  "breadcrumbs.showMethods": false,
  "breadcrumbs.showModules": false,
  "breadcrumbs.showNamespaces": false,
  "breadcrumbs.showNull": false,
  "breadcrumbs.showNumbers": false,
  "breadcrumbs.showObjects": false,
  "breadcrumbs.showOperators": false,
  "breadcrumbs.showPackages": false,
  "breadcrumbs.showProperties": false,
  "breadcrumbs.showStrings": false,
  "breadcrumbs.showStructs": false,
  "breadcrumbs.showTypeParameters": false,
  "breadcrumbs.showVariables": false,
  "security.workspace.trust.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "explorer.confirmDragAndDrop": false,
  "editor.fontFamily": "'JetBrainsMono NF'",
  "git.enableSmartCommit": true,
  "editor.accessibilitySupport": "off",
  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.clang_format_fallbackStyle": "none",
  "C_Cpp.clang_format_style": "file",
  "makefile.configurations": [
    {
      "name": "Default",
      "makefile": "${workspaceFolder}/Makefile"
    }
  ],
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "prettier.printWidth": 120,
  "prettier.trailingComma": "all",
  "prettier.semi": false,
  "makefile.configureOnOpen": true,
  "isort.interpreter": ["python"],
  "explorer.confirmPasteNative": false,
  "dart.flutterCreatePlatforms": ["android", "ios", "web"],
  "dart.flutterCreateOrganization": "com.nashy",
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "GitHub.vscode-pull-request-github"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "chat.commandCenter.enabled": false,
  "window.menuBarVisibility": "compact",
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "editor.fontWeight": "600",
  "workbench.tips.enabled": false,
  "telemetry.feedback.enabled": false,
  "files.exclude": {
    "**/__pycache__": true
  },
  "workbench.colorTheme": "One Dark Pro",
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "editor.quickSuggestions": {
      "strings": "on"
    }
  },
  "terminal.integrated.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "security.allowedUNCHosts": ["wsl.localhost"],
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "claudeCode.preferredLocation": "panel",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "css.lint.boxModel": "warning",
  "css.lint.duplicateProperties": "error",
  "css.lint.float": "warning",
  "css.lint.important": "warning",
  "css.lint.universalSelector": "warning",
  "css.lint.zeroUnits": "warning",
  "less.lint.float": "warning",
  "intellij.region": "europe",
  "intellij.dataSharing": "none",
  "editor.formatOnSave": true,
  "luau-lsp.completion.imports.useConst": true,
  "window.newWindowProfile": "Python"
}
